{
  "name": "@smanga/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "tsx": "4.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.1",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vitest": "^3.2.6"
  }
}
