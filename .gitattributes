# Default: let git normalize line endings (LF in repo, native on checkout).
* text=auto

# Files Linux executes / systemd reads — MUST be LF in working tree, not just repo.
# (Otherwise bash sees "\r" in the shebang and refuses to exec.)
*.sh           text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.service      text eol=lf
*.timer        text eol=lf
*.conf         text eol=lf
Dockerfile     text eol=lf
.dockerignore  text eol=lf
deploy/**      text eol=lf

# Binary blobs (no diff, no eol munging)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
